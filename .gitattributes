* text=auto

# Project-authored Unreal binary assets are stored through Git LFS. Immutable
# vendor packages remain excluded by .gitignore and are distributed separately.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
# W11 source artwork and audio are project-authored binary masters. Keep them
# available to collaborators without inflating normal Git history.
SourceArt/W11/**/*.png filter=lfs diff=lfs merge=lfs -text
SourceArt/W11/**/*.jpg filter=lfs diff=lfs merge=lfs -text
SourceArt/W11/**/*.gif filter=lfs diff=lfs merge=lfs -text
SourceArt/W11/**/*.wav filter=lfs diff=lfs merge=lfs -text
SourceArt/W11/**/*.ogg filter=lfs diff=lfs merge=lfs -text
SourceArt/W11/**/*.zip filter=lfs diff=lfs merge=lfs -text
SourceArt/W11/**/*.ttf filter=lfs diff=lfs merge=lfs -text
