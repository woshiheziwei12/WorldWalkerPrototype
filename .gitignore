# Unreal Engine generated files
[Bb]inaries/
[Dd]erivedDataCache/
[Ii]ntermediate/
[Ss]aved/
LocalBuilds/
[Bb]uild/[Rr]eceipts/

# Immutable third-party Unreal assets are distributed as a separate package.
# Project-authored assets under Content/WorldWalker remain versioned via Git LFS.
/Content/AnimeCharacters/
/Content/Asian_Village/
/Content/Portals/
/Content/Realistic_Starter_VFX_Pack_Vol2/
/Content/ThirdParty/
/Content/WorldWalker/Worlds/*/ThirdParty/

# Unreal per-user content
/Plugins/Developer/RiderLink/

# Visual Studio / Rider / VS Code / Xcode
.vs/
.idea/
.vscode/
*.sln
*.slnx
*.suo
*.user
*.userosscache
*.sdf
*.opensdf
*.VC.db*
*.sln.docstates
*.xcodeproj
*.xcworkspace
*.code-workspace
compile_commands.json

# Python generated files and local environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
env/

# Local environment and secrets
.env
.env.*
!.env.example

# Logs, crashes, temporary and backup files
*.log
*.dmp
*.tmp
*.temp
*.bak
*.orig
*.rej
*.stackdump
*~

# Disposable download/cache locations
/Downloads/
/DownloadCache/
/VendorDownloads/
/Content/WorldWalker/Shared/ThirdParty/
/Cache/
/Temp/
/tmp/
*.download
*.part
*.crdownload

# Operating system files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
